{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/clean-desk-start.sh", "timeout": 10 }] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit", "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/clean-desk-check.sh", "timeout": 10 }] }
    ]
  }
}
